<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_occ_wechat_login_settings" model="ir.actions.act_window">
        <field name="name">OdooCC 微信登录配置</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'general_settings', 'bin_size': False}</field>
    </record>

    <record id="view_occ_wechat_login_acceptance_check_search" model="ir.ui.view">
        <field name="name">occ.wechat.login.acceptance.check.search</field>
        <field name="model">occ.wechat.login.acceptance.check</field>
        <field name="arch" type="xml">
            <search string="微信登录验收清单">
                <field name="name"/>
                <field name="category"/>
                <field name="notes"/>
                <filter name="pending" string="待验收" domain="[('status', '=', 'pending')]"/>
                <filter name="passed" string="通过" domain="[('status', '=', 'passed')]"/>
                <filter name="failed" string="失败" domain="[('status', '=', 'failed')]"/>
                <filter name="blocked" string="阻塞" domain="[('status', '=', 'blocked')]"/>
                <separator/>
                <group>
                    <filter name="group_by_category" string="分类" context="{'group_by': 'category'}"/>
                    <filter name="group_by_status" string="状态" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_occ_wechat_login_acceptance_check_list" model="ir.ui.view">
        <field name="name">occ.wechat.login.acceptance.check.list</field>
        <field name="model">occ.wechat.login.acceptance.check</field>
        <field name="arch" type="xml">
            <list string="微信登录验收清单"
                  default_order="sequence, id"
                  decoration-muted="status == 'pending'"
                  decoration-success="status == 'passed'"
                  decoration-danger="status == 'failed'"
                  decoration-warning="status == 'blocked'">
                <header>
                    <button name="%(action_occ_wechat_login_settings)d"
                            type="action"
                            string="前往微信登录配置"
                            class="btn-secondary"
                            display="always"
                            groups="base.group_system"/>
                </header>
                <field name="sequence" widget="handle"/>
                <field name="category"/>
                <field name="name"/>
                <field name="status"
                       widget="badge"
                       decoration-muted="status == 'pending'"
                       decoration-success="status == 'passed'"
                       decoration-danger="status == 'failed'"
                       decoration-warning="status == 'blocked'"/>
                <field name="notes" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_occ_wechat_login_acceptance_check_form" model="ir.ui.view">
        <field name="name">occ.wechat.login.acceptance.check.form</field>
        <field name="model">occ.wechat.login.acceptance.check</field>
        <field name="arch" type="xml">
            <form string="微信登录验收项">
                <header>
                    <button name="%(action_occ_wechat_login_settings)d"
                            type="action"
                            string="前往微信登录配置"
                            class="btn-secondary"
                            groups="base.group_system"/>
                    <field name="status"
                           widget="statusbar"
                           statusbar_visible="pending,passed,failed,blocked"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        本模块只记录验收结论。请勿填写 AppSecret、密码、Token、微信授权码、邮箱验证链接或完整个人身份标识。
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="验收项"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="category"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="steps" string="验收步骤">
                            <field name="steps" nolabel="1" placeholder="描述使用真实微信完成验收的步骤"/>
                        </page>
                        <page name="expected_result" string="预期结果">
                            <field name="expected_result" nolabel="1" placeholder="描述不包含敏感数据的可观察结果"/>
                        </page>
                        <page name="notes" string="脱敏备注">
                            <field name="notes" nolabel="1" placeholder="仅填写脱敏结论、问题现象或阻塞原因"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_occ_wechat_login_acceptance_check" model="ir.actions.act_window">
        <field name="name">微信登录验收清单</field>
        <field name="res_model">occ.wechat.login.acceptance.check</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_occ_wechat_login_acceptance_check_list"/>
        <field name="search_view_id" ref="view_occ_wechat_login_acceptance_check_search"/>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">创建一项微信登录验收检查</p>
            <p>请使用真实微信和真实邮件链路执行检查，只记录脱敏结论。</p>
        </field>
    </record>

    <menuitem id="menu_occ_wechat_login_acceptance_root"
              name="微信登录验收"
              parent="base.menu_administration"
              sequence="90"
              groups="base.group_system"/>

    <menuitem id="menu_occ_wechat_login_acceptance_check"
              name="验收清单"
              parent="menu_occ_wechat_login_acceptance_root"
              action="action_occ_wechat_login_acceptance_check"
              sequence="10"
              groups="base.group_system"/>

    <menuitem id="menu_occ_wechat_login_settings"
              name="前往微信登录配置"
              parent="menu_occ_wechat_login_acceptance_root"
              action="action_occ_wechat_login_settings"
              sequence="20"
              groups="base.group_system"/>
</odoo>
