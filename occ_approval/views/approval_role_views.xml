<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_approval_role_list" model="ir.ui.view">
        <field name="name">occ.approval.role.list</field>
        <field name="model">occ.approval.role</field>
        <field name="arch" type="xml">
            <list string="审批角色">
                <field name="name"/>
                <field name="code" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="user_ids" widget="many2many_tags"
                       options="{'color_field': 'color'}"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_approval_role_form" model="ir.ui.view">
        <field name="name">occ.approval.role.form</field>
        <field name="model">occ.approval.role</field>
        <field name="arch" type="xml">
            <form string="审批角色">
                <sheet>
                    <widget name="web_ribbon" title="已归档" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="例如：财务负责人"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="成员">
                        <field name="user_ids" widget="many2many_tags"
                               domain="[('share', '=', False), ('company_ids', 'in', company_id)]"
                               options="{'no_create': True}" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_approval_role_search" model="ir.ui.view">
        <field name="name">occ.approval.role.search</field>
        <field name="model">occ.approval.role</field>
        <field name="arch" type="xml">
            <search string="审批角色">
                <field name="name"/>
                <field name="code"/>
                <field name="user_ids"/>
                <filter name="archived" string="已归档" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_company" string="公司"
                            context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_approval_roles" model="ir.actions.act_window">
        <field name="name">审批角色</field>
        <field name="res_model">occ.approval.role</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_approval_role_search"/>
    </record>
</odoo>
