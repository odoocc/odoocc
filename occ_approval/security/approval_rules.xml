<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Published definitions and a participant's archived history remain readable. -->
        <record id="rule_approval_workflow_user" model="ir.rule">
            <field name="name">Approval workflow: published or participated history in active companies</field>
            <field name="model_id" ref="model_occ_approval_workflow"/>
            <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), '|', ('state', '=', 'published'), '|', '|', ('instance_ids.requester_id', '=', user.id), ('instance_ids.participant_user_ids', 'in', user.id), ('instance_ids.task_ids.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_approval_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_approval_workflow_version_user" model="ir.rule">
            <field name="name">Approval workflow version: published or participated history in active companies</field>
            <field name="model_id" ref="model_occ_approval_workflow_version"/>
            <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), '|', ('workflow_id.state', '=', 'published'), '|', '|', ('instance_ids.requester_id', '=', user.id), ('instance_ids.participant_user_ids', 'in', user.id), ('instance_ids.task_ids.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_approval_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Managers manage definitions and inspect runtime data only in active companies. -->
        <record id="rule_approval_workflow_manager" model="ir.rule">
            <field name="name">Approval workflow: manager active companies</field>
            <field name="model_id" ref="model_occ_approval_workflow"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_approval_manager'))]"/>
        </record>

        <record id="rule_approval_workflow_version_manager" model="ir.rule">
            <field name="name">Approval workflow version: manager active companies</field>
            <field name="model_id" ref="model_occ_approval_workflow_version"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_approval_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_approval_role_manager" model="ir.rule">
            <field name="name">Approval role: manager active companies</field>
            <field name="model_id" ref="model_occ_approval_role"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_approval_manager'))]"/>
        </record>

        <!-- Technical administrators can manage definitions across companies. -->
        <record id="rule_approval_workflow_technical" model="ir.rule">
            <field name="name">Approval workflow: technical administrator all companies</field>
            <field name="model_id" ref="model_occ_approval_workflow"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_approval_technical'))]"/>
        </record>

        <record id="rule_approval_workflow_version_technical" model="ir.rule">
            <field name="name">Approval workflow version: technical administrator all companies</field>
            <field name="model_id" ref="model_occ_approval_workflow_version"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_approval_technical'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_approval_role_technical" model="ir.rule">
            <field name="name">Approval role: technical administrator all companies</field>
            <field name="model_id" ref="model_occ_approval_role"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_approval_technical'))]"/>
        </record>

        <!-- Runtime records are read-only through ACLs; rules scope who can inspect them. -->
        <record id="rule_approval_instance_user" model="ir.rule">
            <field name="name">Approval instance: requester or participant in active companies</field>
            <field name="model_id" ref="model_occ_approval_instance"/>
            <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), '|', '|', ('requester_id', '=', user.id), ('participant_user_ids', 'in', user.id), ('task_ids.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_approval_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_approval_instance_manager" model="ir.rule">
            <field name="name">Approval instance: manager active companies</field>
            <field name="model_id" ref="model_occ_approval_instance"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_approval_manager'))]"/>
            <field name="perm_read" eval="True"/>
