            <field name="domain_force">['&amp;', ('instance_id.company_id', 'in', company_ids), '|', '|', ('instance_id.requester_id', '=', user.id), ('instance_id.participant_user_ids', 'in', user.id), ('instance_id.task_ids.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_approval_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_approval_instance_node_manager" model="ir.rule">
            <field name="name">Approval instance node: manager active companies</field>
            <field name="model_id" ref="model_occ_approval_instance_node"/>
            <field name="domain_force">[('instance_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_approval_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_approval_task_user" model="ir.rule">
            <field name="name">Approval task: assignee, requester or participant in active companies</field>
            <field name="model_id" ref="model_occ_approval_task"/>
            <field name="domain_force">['&amp;', ('instance_id.company_id', 'in', company_ids), '|', '|', ('user_id', '=', user.id), ('instance_id.requester_id', '=', user.id), ('instance_id.participant_user_ids', 'in', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_approval_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_approval_task_manager" model="ir.rule">
            <field name="name">Approval task: manager active companies</field>
            <field name="model_id" ref="model_occ_approval_task"/>
            <field name="domain_force">[('instance_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_approval_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_approval_event_user" model="ir.rule">
            <field name="name">Approval event: requester or participant in active companies</field>
            <field name="model_id" ref="model_occ_approval_event"/>
            <field name="domain_force">['&amp;', ('instance_id.company_id', 'in', company_ids), '|', '|', ('instance_id.requester_id', '=', user.id), ('instance_id.participant_user_ids', 'in', user.id), ('instance_id.task_ids.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_approval_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_approval_event_manager" model="ir.rule">
            <field name="name">Approval event: manager active companies</field>
            <field name="model_id" ref="model_occ_approval_event"/>
            <field name="domain_force">[('instance_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_approval_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
