<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="res_groups_privilege_approval" model="res.groups.privilege">
            <field name="name">Approvals</field>
            <field name="sequence">35</field>
            <field name="category_id" ref="base.module_category_productivity"/>
        </record>

        <record id="group_approval_user" model="res.groups">
            <field name="name">User</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_approval"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_approval_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_approval"/>
            <field name="implied_ids" eval="[(4, ref('group_approval_user'))]"/>
        </record>

        <record id="group_approval_technical" model="res.groups">
            <field name="name">Technical Administrator</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="res_groups_privilege_approval"/>
            <field name="implied_ids" eval="[(4, ref('group_approval_manager'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
