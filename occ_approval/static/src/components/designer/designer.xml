<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="occ_approval.ApprovalDesigner">
        <div class="o_occ_designer" tabindex="0" t-on-keydown="onKeydown">
            <header class="o_occ_designer_header">
                <div class="o_occ_designer_title">
                    <div class="d-flex align-items-center gap-2">
                        <h2 class="m-0 text-truncate" t-esc="state.workflowName"/>
                        <span class="badge rounded-pill text-bg-light" t-esc="state.workflowState"/>
                        <span t-if="state.dirty" class="badge rounded-pill text-bg-warning">
                            Unsaved
                        </span>
                    </div>
                    <small class="text-muted">
                        <t t-esc="'Revision ' + state.revision"/>
                    </small>
                </div>
                <div class="o_occ_designer_actions" role="toolbar" aria-label="Workflow actions">
                    <button type="button" class="btn btn-outline-secondary" t-on-click="autoLayout" aria-label="Automatically arrange nodes">
                        <i class="fa fa-magic me-1" aria-hidden="true"/>
                        Auto layout
                    </button>
                    <button type="button" class="btn btn-outline-danger" t-on-click="requestDeleteSelection" t-att-disabled="!selectedNode and !selectedEdge" aria-label="Delete selected item">
                        <i class="fa fa-trash me-1" aria-hidden="true"/>
                        Delete
                    </button>
                    <button type="button" class="btn btn-primary" t-on-click="save" t-att-disabled="state.saving or state.publishing or !state.dirty">
                        <i t-if="state.saving" class="fa fa-spinner fa-spin me-1" aria-hidden="true"/>
                        <i t-else="" class="fa fa-save me-1" aria-hidden="true"/>
                        Save
                    </button>
                    <button type="button" class="btn btn-success" t-on-click="onPublishClick" t-att-disabled="state.saving or state.publishing">
                        <i t-if="state.publishing" class="fa fa-spinner fa-spin me-1" aria-hidden="true"/>
                        <i t-else="" class="fa fa-cloud-upload me-1" aria-hidden="true"/>
                        Publish
                    </button>
                </div>
            </header>

            <div t-if="state.loading" class="o_occ_designer_loading" role="status">
                <i class="fa fa-spinner fa-spin" aria-hidden="true"/>
                <span>Loading workflow…</span>
            </div>

            <t t-else="">
                <div t-if="state.validationErrors.length" class="alert alert-danger m-3 mb-0" role="alert">
                    <div class="fw-bold mb-1">Please fix the workflow before continuing:</div>
                    <ul class="mb-0">
                        <li t-foreach="state.validationErrors" t-as="error" t-key="error" t-esc="error"/>
                    </ul>
                </div>

                <div class="o_occ_designer_body">
                    <aside class="o_occ_palette" aria-label="Node palette">
                        <h3>Nodes</h3>
                        <p class="text-muted small">Add a node, then use its connector button and select a destination.</p>
                        <div class="o_occ_palette_list">
                            <button
                                t-foreach="nodeTypeOrder"
                                t-as="type"
                                t-key="type"
                                type="button"
                                class="o_occ_palette_item"
                                t-att-disabled="!canAddType(type)"
                                t-on-click="() => this.addNode(type)"
                                t-att-aria-label="'Add ' + nodeTypeLabel(type) + ' node'">
                                <span t-attf-class="o_occ_node_icon o_occ_node_icon_{{ type }}">
                                    <i t-attf-class="fa {{ nodeTypes[type].icon }}" aria-hidden="true"/>
                                </span>
                                <span>
                                    <strong t-esc="nodeTypeLabel(type)"/>
                                    <small t-if="type === 'approval'">Decision and approval</small>
                                    <small t-elif="type === 'task'">Work to complete</small>
                                    <small t-elif="type === 'copy'">Notify recipients</small>
                                    <small t-elif="type === 'start'">Workflow entry</small>
                                    <small t-else="">Workflow completion</small>
                                </span>
                            </button>
                        </div>
                    </aside>

                    <main
                        class="o_occ_canvas"
                        t-ref="canvas"
                        aria-label="Workflow canvas"
                        t-on-pointerdown="onCanvasPointerDown"
                        t-on-pointermove="onCanvasPointerMove"
                        t-on-pointerup="onCanvasPointerUp"
                        t-on-pointercancel="onCanvasPointerUp">
                        <div class="o_occ_scene" t-att-style="sceneStyle">
                            <svg class="o_occ_edges" t-att-width="canvasSize.width" t-att-height="canvasSize.height" role="group" aria-label="Workflow connections">
                                <defs>
                                    <marker id="o_occ_arrow" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto" markerUnits="strokeWidth">
                                        <path d="M0,0 L0,6 L9,3 z" class="o_occ_arrow_head"/>
                                    </marker>
                                </defs>
                                <t t-foreach="state.graph.edges" t-as="edge" t-key="edge.id">
                                    <path
                                        t-att-d="edgePath(edge)"
                                        t-att-class="{'o_occ_edge': true, 'is-selected': state.selectedEdgeId === edge.id}"
                                        marker-end="url(#o_occ_arrow)"/>
                                    <path
                                        t-att-d="edgePath(edge)"
                                        class="o_occ_edge_hit"
                                        tabindex="0"
                                        role="button"
                                        t-att-aria-label="'Connection from ' + nodeName(edge.source) + ' to ' + nodeName(edge.target)"
                                        t-on-click="(ev) => this.selectEdge(edge, ev)"
                                        t-on-keydown="(ev) => this.onEdgeKeydown(ev, edge)"/>
                                    <g t-att-transform="'translate(' + edgeLabelPosition(edge).x + ',' + edgeLabelPosition(edge).y + ')'" class="o_occ_edge_label">
                                        <rect x="-62" y="-14" width="124" height="24" rx="12"/>
                                        <text text-anchor="middle" dominant-baseline="middle" t-esc="edgeSummary(edge)"/>
                                    </g>
                                </t>
                            </svg>

                            <article
                                t-foreach="state.graph.nodes"
                                t-as="node"
                                t-key="node.id"
                                tabindex="0"
                                t-att-style="nodeStyle(node)"
                                t-att-class="{
                                    'o_occ_node': true,
                                    'is-selected': state.selectedNodeId === node.id,
                                    'is-link-source': state.linkSourceId === node.id,
                                    ['o_occ_node_' + node.type]: true,
                                }"
                                t-att-aria-label="nodeTypeLabel(node.type) + ': ' + node.label"
                                t-on-pointerdown="(ev) => this.onNodePointerDown(ev, node)"
                                t-on-pointermove="onNodePointerMove"
                                t-on-pointerup="(ev) => this.onNodePointerUp(ev, node)"
                                t-on-pointercancel="(ev) => this.onNodePointerUp(ev, node)"
                                t-on-keydown="(ev) => this.onNodeKeydown(ev, node)">
                                <header>
                                    <span t-attf-class="o_occ_node_icon o_occ_node_icon_{{ node.type }}">
                                        <i t-attf-class="fa {{ nodeTypes[node.type].icon }}" aria-hidden="true"/>
                                    </span>
                                    <span class="text-truncate" t-esc="node.label"/>
                                    <button
                                        t-if="node.type !== 'end'"
                                        type="button"
                                        class="btn btn-sm o_occ_link_button"
                                        t-on-click="(ev) => this.startLink(node, ev)"
                                        t-att-aria-label="'Connect from ' + node.label"
                                        title="Create connection">
                                        <i class="fa fa-link" aria-hidden="true"/>
                                    </button>
                                </header>
                                <div class="o_occ_node_content">
                                    <span class="badge text-bg-light" t-esc="nodeTypeLabel(node.type)"/>
                                    <small t-if="node.description" class="text-muted text-truncate" t-esc="node.description"/>
                                    <small t-elif="['approval', 'task', 'copy'].includes(node.type)" class="text-muted" t-esc="node.config.assignee_mode"/>
                                    <small t-else="" class="text-muted" t-esc="node.id"/>
                                </div>
                            </article>
                        </div>

                        <div class="o_occ_zoom_controls" role="toolbar" aria-label="Canvas zoom">
                            <button type="button" class="btn btn-light" t-on-click="zoomOut" aria-label="Zoom out">
                                <i class="fa fa-minus" aria-hidden="true"/>
                            </button>
                            <span class="o_occ_zoom_value" aria-live="polite" t-esc="zoomLabel"/>
                            <button type="button" class="btn btn-light" t-on-click="zoomIn" aria-label="Zoom in">
                                <i class="fa fa-plus" aria-hidden="true"/>
                            </button>
                            <button type="button" class="btn btn-light" t-on-click="fitGraph" aria-label="Fit workflow to screen" title="Fit to screen">
                                <i class="fa fa-compress" aria-hidden="true"/>
                            </button>
                            <button type="button" class="btn btn-light" t-on-click="resetViewport" aria-label="Reset canvas position" title="Reset view">
                                <i class="fa fa-crosshairs" aria-hidden="true"/>
                            </button>
                        </div>
                    </main>

                    <aside class="o_occ_inspector" aria-label="Workflow inspector">
                        <t t-if="selectedNode">
                            <div class="o_occ_inspector_heading">
                                <span t-attf-class="o_occ_node_icon o_occ_node_icon_{{ selectedNode.type }}">
                                    <i t-attf-class="fa {{ nodeTypes[selectedNode.type].icon }}" aria-hidden="true"/>
                                </span>
                                <div>
                                    <h3 t-esc="nodeTypeLabel(selectedNode.type)"/>
                                    <small class="text-muted" t-esc="selectedNode.id"/>
                                </div>
                            </div>

                            <label class="form-label" for="occ_node_name">Name</label>
                            <input id="occ_node_name" class="form-control" type="text" t-att-value="selectedNode.label" t-on-input="(ev) => this.updateNodeField('label', ev)"/>

                            <label class="form-label mt-3" for="occ_node_description">Description</label>
                            <textarea id="occ_node_description" class="form-control" rows="3" t-att-value="selectedNode.description" t-on-input="(ev) => this.updateNodeField('description', ev)"></textarea>

                            <t t-if="['approval', 'task', 'copy'].includes(selectedNode.type)">
                                <hr/>
                                <h4>Assignment</h4>
                                <label class="form-label" for="occ_assignee_mode">Assignee source</label>
                                <select id="occ_assignee_mode" class="form-select" t-on-change="(ev) => this.updateNodeConfig('assignee_mode', ev)">
                                    <option value="users" t-att-selected="selectedNode.config.assignee_mode === 'users'">Specified users</option>
                                    <option value="role" t-att-selected="selectedNode.config.assignee_mode === 'role'">Approval role</option>
                                    <option value="manager" t-att-selected="selectedNode.config.assignee_mode === 'manager'">Manager</option>
                                    <option value="manager_chain" t-att-selected="selectedNode.config.assignee_mode === 'manager_chain'">Manager chain</option>
                                    <option value="requester" t-att-selected="selectedNode.config.assignee_mode === 'requester'">Requester</option>
                                    <option value="requester_choice" t-att-selected="selectedNode.config.assignee_mode === 'requester_choice'">Requester chooses</option>
                                </select>

                                <t t-if="selectedNode.config.assignee_mode === 'users'">
                                    <label class="form-label mt-3" for="occ_user_search">Specified users</label>
                                    <form class="input-group" t-on-submit="searchAssignmentUsers">
                                        <input
                                            id="occ_user_search"
                                            class="form-control"
                                            type="search"
                                            placeholder="Search active internal users"
                                            t-att-value="state.assignmentUserQuery"
                                            t-on-input="updateAssignmentUserQuery"/>
                                        <button class="btn btn-outline-secondary" type="submit" t-att-disabled="state.assignmentOptionsLoading">
                                            <i t-if="state.assignmentOptionsLoading" class="fa fa-spinner fa-spin" aria-hidden="true"/>
                                            <i t-else="" class="fa fa-search" aria-hidden="true"/>
                                            <span class="visually-hidden">Search users</span>
                                        </button>
                                    </form>
                                    <div t-if="selectedAssignmentUsers.length" class="o_occ_assignment_chips" aria-label="Selected users">
                                        <span t-foreach="selectedAssignmentUsers" t-as="user" t-key="user.id" class="o_occ_assignment_chip">
                                            <span class="text-truncate" t-esc="user.name"/>
                                            <button type="button" t-on-click="() => this.removeAssignmentUser(user.id)" t-att-aria-label="'Remove ' + user.name">
                                                <i class="fa fa-times" aria-hidden="true"/>
                                            </button>
                                        </span>
                                    </div>
                                    <div class="o_occ_assignment_results">
                                        <label t-foreach="assignmentUserResults" t-as="user" t-key="user.id" class="o_occ_assignment_user">
                                            <input
                                                class="form-check-input"
                                                type="checkbox"
                                                t-att-checked="isAssignmentUserSelected(user.id)"
                                                t-on-change="() => this.toggleAssignmentUser(user.id)"/>
                                            <span class="o_occ_assignment_avatar" aria-hidden="true" t-esc="(user.name || '?').slice(0, 1).toUpperCase()"/>
                                            <span class="text-truncate">
                                                <strong class="d-block text-truncate" t-esc="user.name"/>
                                                <small t-if="user.login || user.email" class="text-muted text-truncate" t-esc="user.login || user.email"/>
                                            </span>
                                        </label>
                                        <div t-if="!state.assignmentOptionsLoading and !assignmentUserResults.length" class="o_occ_assignment_empty">
                                            No matching eligible users.
                                        </div>
                                    </div>
                                </t>
                                <t t-elif="selectedNode.config.assignee_mode === 'role'">
                                    <label class="form-label mt-3" for="occ_role_id">Approval role</label>
                                    <select id="occ_role_id" class="form-select" t-on-change="selectAssignmentRole">
                                        <option value="">Select a role</option>
                                        <option
                                            t-foreach="state.assignmentRoles"
                                            t-as="role"
                                            t-key="role.id"
                                            t-att-value="role.id"
                                            t-att-selected="isAssignmentRoleSelected(role.id)"
                                            t-esc="role.name"/>
                                    </select>
                                    <div t-if="!state.assignmentOptionsLoading and !state.assignmentRoles.length" class="form-text text-warning">
                                        No active approval role is available for this company.
                                    </div>
                                </t>
                                <t t-elif="selectedNode.config.assignee_mode === 'manager'">
                                    <label class="form-label mt-3" for="occ_manager_level">Manager level</label>
                                    <input id="occ_manager_level" class="form-control" type="number" min="1" max="100" t-att-value="selectedNode.config.manager_level" t-on-change="(ev) => this.updateNodeConfig('manager_level', ev)"/>
                                </t>
                                <t t-elif="selectedNode.config.assignee_mode === 'manager_chain'">
                                    <label class="form-label mt-3" for="occ_manager_levels">Number of levels</label>
                                    <input id="occ_manager_levels" class="form-control" type="number" min="0" max="100" t-att-value="selectedNode.config.manager_chain_levels" t-on-change="(ev) => this.updateNodeConfig('manager_chain_levels', ev)"/>
                                    <div class="form-text">Use 0 to continue to the highest available manager.</div>
                                </t>
                            </t>

                            <t t-if="['approval', 'task'].includes(selectedNode.type)">
                                <hr/>
                                <h4>Execution</h4>
                                <label class="form-label" for="occ_action_mode">Multiple assignees</label>
                                <select t-if="selectedNode.type === 'approval'" id="occ_action_mode" class="form-select" t-on-change="(ev) => this.updateNodeConfig('approval_mode', ev)">
                                    <option value="all" t-att-selected="selectedNode.config.approval_mode === 'all'">All must approve</option>
                                    <option value="any" t-att-selected="selectedNode.config.approval_mode === 'any'">Any one may approve</option>
                                </select>
                                <select t-else="" id="occ_action_mode" class="form-select" t-on-change="(ev) => this.updateNodeConfig('completion_mode', ev)">
                                    <option value="all" t-att-selected="selectedNode.config.completion_mode === 'all'">All must complete</option>
                                    <option value="any" t-att-selected="selectedNode.config.completion_mode === 'any'">Any one may complete</option>
                                </select>

                                <div class="row g-2 mt-2">
                                    <div class="col-6">
                                        <label class="form-label" for="occ_deadline_hours">Deadline hours</label>
                                        <input id="occ_deadline_hours" class="form-control" type="number" min="0" t-att-value="selectedNode.config.deadline_hours" t-on-change="(ev) => this.updateNodeConfig('deadline_hours', ev)"/>
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label" for="occ_reminder_hours">Remind before</label>
                                        <input id="occ_reminder_hours" class="form-control" type="number" min="0" t-att-value="selectedNode.config.reminder_before_hours" t-on-change="(ev) => this.updateNodeConfig('reminder_before_hours', ev)"/>
                                    </div>
                                </div>

                                <label class="form-label mt-3" for="occ_timeout_action">On timeout</label>
                                <select id="occ_timeout_action" class="form-select" t-on-change="(ev) => this.updateNodeConfig('timeout_action', ev)">
                                    <option value="none" t-att-selected="selectedNode.config.timeout_action === 'none'">Do nothing</option>
                                    <option value="approve" t-att-selected="selectedNode.config.timeout_action === 'approve'">Approve automatically</option>
                                    <option value="reject" t-att-selected="selectedNode.config.timeout_action === 'reject'">Reject automatically</option>
                                </select>
                                <div t-if="selectedNode.config.timeout_action === 'reject'" class="mt-2">
                                    <label class="form-label" for="occ_timeout_target">Reject to node</label>
                                    <select id="occ_timeout_target" class="form-select" t-on-change="(ev) => this.updateNodeConfig('timeout_reject_node', ev)">
                                        <option value="">Select a previous node</option>
                                        <option t-foreach="state.graph.nodes.filter((node) => node.id !== selectedNode.id and node.type !== 'end')" t-as="node" t-key="node.id" t-att-value="node.id" t-att-selected="selectedNode.config.timeout_reject_node === node.id" t-esc="node.label"/>
                                    </select>
                                    <label class="form-label mt-2" for="occ_timeout_reject_mode">Resume mode</label>
                                    <select id="occ_timeout_reject_mode" class="form-select" t-on-change="(ev) => this.updateNodeConfig('timeout_reject_mode', ev)">
                                        <option value="direct" t-att-selected="selectedNode.config.timeout_reject_mode === 'direct'">Return directly to this node</option>
                                        <option value="sequential" t-att-selected="selectedNode.config.timeout_reject_mode === 'sequential'">Follow the workflow again</option>
                                    </select>
                                </div>
                            </t>
                        </t>

                        <t t-elif="selectedEdge">
                            <div class="o_occ_inspector_heading">
                                <span class="o_occ_node_icon o_occ_node_icon_edge">
                                    <i class="fa fa-random" aria-hidden="true"/>
                                </span>
                                <div>
                                    <h3>Connection</h3>
                                    <small class="text-muted">
                                        <t t-esc="nodeName(selectedEdge.source)"/> → <t t-esc="nodeName(selectedEdge.target)"/>
                                    </small>
                                </div>
                            </div>

                            <label class="form-label" for="occ_edge_label">Display label</label>
                            <input id="occ_edge_label" class="form-control" type="text" t-att-value="selectedEdge.condition.label" t-on-input="(ev) => this.updateEdgeCondition('label', ev)"/>

                            <label class="form-label mt-3" for="occ_edge_sequence">Priority</label>
                            <input id="occ_edge_sequence" class="form-control" type="number" min="1" step="10" t-att-value="selectedEdge.sequence" t-on-change="updateEdgeSequence"/>
                            <div class="form-text">Lower values are evaluated first. Fallback is always saved last.</div>

                            <div class="form-check mt-3">
                                <input id="occ_advanced_condition" class="form-check-input" type="checkbox" t-att-checked="selectedEdge.condition.advanced" t-on-change="toggleAdvancedCondition"/>
                                <label for="occ_advanced_condition" class="form-check-label">Advanced Odoo domain</label>
                            </div>

                            <t t-if="selectedEdge.condition.advanced">
                                <label class="form-label mt-3" for="occ_edge_domain">Domain JSON</label>
                                <textarea id="occ_edge_domain" class="form-control font-monospace" rows="6" placeholder='[["amount_total", ">", 1000]]' t-att-value="selectedEdge.condition.value" t-on-input="(ev) => this.updateEdgeCondition('value', ev)"></textarea>
                            </t>
                            <t t-else="">
                                <label class="form-label mt-3" for="occ_edge_field">Field</label>
                                <input id="occ_edge_field" class="form-control" type="text" placeholder="amount_total" t-att-value="selectedEdge.condition.field" t-on-input="(ev) => this.updateEdgeCondition('field', ev)"/>
                                <div t-if="!selectedEdge.condition.field" class="alert alert-info py-2 mt-2 mb-0">
                                    An empty field makes this the fallback connection.
                                </div>

                                <label class="form-label mt-3" for="occ_edge_operator">Operator</label>
                                <select id="occ_edge_operator" class="form-select" t-on-change="(ev) => this.updateEdgeCondition('operator', ev)">
                                    <option t-foreach="['=', '!=', '&gt;', '&gt;=', '&lt;', '&lt;=', 'in', 'not in', 'ilike', 'not ilike']" t-as="operator" t-key="operator" t-att-value="operator" t-att-selected="selectedEdge.condition.operator === operator" t-esc="operator"/>
                                </select>

                                <label class="form-label mt-3" for="occ_edge_value_type">Value type</label>
                                <select id="occ_edge_value_type" class="form-select" t-on-change="(ev) => this.updateEdgeCondition('value_type', ev)">
                                    <option value="string" t-att-selected="selectedEdge.condition.value_type === 'string'">Text</option>
                                    <option value="number" t-att-selected="selectedEdge.condition.value_type === 'number'">Number</option>
                                    <option value="boolean" t-att-selected="selectedEdge.condition.value_type === 'boolean'">Boolean</option>
                                    <option value="null" t-att-selected="selectedEdge.condition.value_type === 'null'">Null</option>
                                    <option value="json" t-att-selected="selectedEdge.condition.value_type === 'json'">JSON value</option>
                                </select>

                                <label class="form-label mt-3" for="occ_edge_value">Value</label>
                                <div t-if="selectedEdge.condition.value_type === 'null'" id="occ_edge_value" class="form-text">This condition will use the JSON null value.</div>
                                <select t-elif="selectedEdge.condition.value_type === 'boolean'" id="occ_edge_value" class="form-select" t-on-change="(ev) => this.updateEdgeCondition('value', ev)">
                                    <option value="true" t-att-selected="selectedEdge.condition.value === 'true'">True</option>
                                    <option value="false" t-att-selected="selectedEdge.condition.value === 'false'">False</option>
                                </select>
                                <input
                                    t-else=""
                                    id="occ_edge_value"
                                    class="form-control"
                                    type="text"
                                    t-att-placeholder="selectedEdge.condition.value_type === 'json' ? '[1, 2]' : selectedEdge.condition.value_type === 'number' ? '1000' : 'Text value'"
                                    t-att-value="selectedEdge.condition.value"
                                    t-on-input="(ev) => this.updateEdgeCondition('value', ev)"/>
                            </t>
                        </t>

                        <div t-else="" class="o_occ_inspector_empty">
                            <i class="fa fa-mouse-pointer" aria-hidden="true"/>
                            <h3>Select a node or connection</h3>
                            <p>Configure assignment, deadlines, rejection behavior, or routing conditions here.</p>
                            <kbd>Ctrl</kbd> + <kbd>S</kbd>
                            <span class="small text-muted ms-1">saves the draft</span>
                        </div>
                    </aside>
                </div>
            </t>
        </div>
    </t>
</templates>
