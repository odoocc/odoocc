<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="occ_treegrid.ListRenderer" t-inherit="web.ListRenderer" t-inherit-mode="primary">
        <xpath expr="//table" position="attributes">
            <attribute name="role">treegrid</attribute>
            <attribute name="aria-readonly">true</attribute>
        </xpath>
        <xpath expr="//tbody" position="attributes">
            <attribute name="class">o_treegrid_tbody</attribute>
            <attribute name="role">rowgroup</attribute>
        </xpath>
    </t>

    <t t-name="occ_treegrid.ListRenderer.Rows">
        <t t-foreach="treeRows" t-as="treeRow" t-key="treeRow.record.id">
            <t t-set="record" t-value="treeRow.record"/>
            <t t-call="{{ constructor.recordRowTemplate }}"/>
        </t>
        <t t-if="!props.noContentHelp">
            <tr t-foreach="getEmptyRowIds" t-as="emptyRowId" t-key="emptyRowId">
                <td t-att-colspan="nbCols">&#8203;</td>
            </tr>
        </t>
    </t>

    <t t-name="occ_treegrid.ListRenderer.FieldValue">
        <t t-if="canUseFormatter(column, record)" t-out="getFormattedValue(column, record)"/>
        <Field t-else="" name="column.name" record="record" type="column.widget" class="getFieldClass(column)" fieldInfo="column" t-props="getFieldProps(record, column)"/>
    </t>

    <t t-name="occ_treegrid.ListRenderer.RecordRow">
        <tr class="o_data_row"
            role="row"
            t-att-class="getRowClass(record)"
            t-att-data-id="record.id"
            t-att-data-res-id="record.resId"
            t-att-data-treegrid-parent-id="treeRow.parentId || ''"
            t-att-aria-level="treeRow.depth + 1"
            t-att-aria-expanded="treeRow.hasChildren ? (treeRow.isExpanded ? 'true' : 'false') : undefined"
            t-att-aria-posinset="treeRow.position"
            t-att-aria-setsize="treeRow.setSize"
            t-on-keydown.capture="(ev) => this.onTreeRowKeydown(treeRow, ev)"
            t-on-click.capture="(ev) => this.onClickCapture(record, ev)"
            t-on-mouseover.capture="(ev) => this.ignoreEventInSelectionMode(ev)"
            t-on-mouseout.capture="(ev) => this.ignoreEventInSelectionMode(ev)"
            t-on-mouseenter.capture="(ev) => this.ignoreEventInSelectionMode(ev)"
            t-on-touchstart="(ev) => this.onRowTouchStart(record, ev)"
            t-on-touchend="() => this.onRowTouchEnd(record)"
            t-on-touchmove="() => this.onRowTouchMove(record)"
        >
            <td t-on-keydown="(ev) => this.onCellKeydown(ev, null, record)" t-if="hasSelectors" class="o_list_record_selector user-select-none" t-on-click.stop="() => this.toggleRecordSelection(record)" tabindex="-1">
                <CheckBox t-if="isTreeGridSelectable(record)" disabled="!_canSelectRecord" value="record.selected" onChange.alike="() => this.toggleRecordSelection(record)"/>
            </td>
            <t t-foreach="getColumns(record)" t-as="column" t-key="column.id">
                <t t-if="column.type === 'field'">
                    <t t-set="isInvisible" t-value="evalInvisible(column.invisible, record) or !(column.name in record.data)"/>
                    <td t-on-keydown="(ev) => this.onCellKeydown(ev, null, record)"
                        class="o_data_cell cursor-pointer"
                        role="gridcell"
                        t-att-class="this.getCellClass(column, record)"
                        t-att-name="column.name"
                        t-att-colspan="column.colspan"
                        t-att-data-tooltip="!isInvisible ? getCellTitle(column, record) : false"
                        data-tooltip-delay="1000"
                        t-custom-click="(ev, isMiddleClick) => this.onCellClicked(record, column, ev, isMiddleClick)"
                        tabindex="-1">
                        <t t-if="!isInvisible">
                            <div t-if="isTreeGridColumn(column)" class="o_treegrid_cell d-flex align-items-center min-w-0" t-att-style="getTreeGridIndentStyle(treeRow)">
                                <button t-if="treeRow.hasChildren"
                                    type="button"
                                    class="o_treegrid_toggle btn btn-link p-0 flex-shrink-0"
                                    tabindex="-1"
                                    t-att-aria-label="treeRow.isExpanded ? '收起' : '展开'"
                                    t-att-aria-expanded="treeRow.isExpanded ? 'true' : 'false'"
                                    t-on-click.stop.prevent="() => this.toggleTreeGridRow(treeRow)">
                                    <i class="fa fa-fw" t-att-class="treeRow.isExpanded ? 'fa-caret-down' : 'fa-caret-right'"/>
                                </button>
                                <span t-else="" class="o_treegrid_toggle_spacer flex-shrink-0"/>
                                <div class="o_treegrid_value min-w-0 text-truncate">
                                    <t t-call="occ_treegrid.ListRenderer.FieldValue"/>
                                </div>
                            </div>
                            <t t-else="" t-call="occ_treegrid.ListRenderer.FieldValue"/>
                        </t>
                    </td>
                </t>
                <t t-if="column.type === 'button_group'">
                    <td t-on-keydown="(ev) => this.onCellKeydown(ev, null, record)" class="o_data_cell w-print-0 p-print-0 cursor-pointer" role="gridcell" t-att-class="this.getCellClass(column, record)" t-on-click="(ev) => this.onButtonCellClicked(record, column, ev)" tabindex="-1">
                        <div class="d-flex flex-wrap gap-1">
                            <t t-foreach="column.buttons" t-as="button" t-key="button.id">
                                <ViewButton t-if="!evalInvisible(button.invisible, record)"
                                    className="button.className"
                                    clickParams="button.clickParams"
                                    defaultRank="button.defaultRank"
                                    disabled="button.disabled"
                                    icon="button.icon"
                                    record="record"
                                    string="button.string"
                                    title="button.title"
                                    tabindex="editedRecord ? '-1' : '0'"/>
                            </t>
                        </div>
                    </td>
                </t>
                <t t-if="column.type === 'widget'">
                    <td class="o_data_cell" role="gridcell" t-att-class="this.getCellClass(column, record)">
                        <Widget t-props="column.props" record="record"/>
                    </td>
                </t>
            </t>

            <td t-if="hasOpenFormViewColumn" class="o_list_record_open_form_view w-print-0 p-print-0 text-center" role="gridcell" t-on-keydown="(ev) => this.onCellKeydown(ev, null, record)" t-custom-click.stop="(ev, newWindow) => props.onOpenFormView(record, { force: true, newWindow })" tabindex="-1">
                <button class="btn btn-link align-top text-end" name="Open in form view" aria-label="在表单视图中打开" tabindex="-1">查看</button>
            </td>

            <t t-set="useUnlink" t-value="'unlink' in activeActions"/>
            <t t-set="hasX2ManyAction" t-value="isX2Many and (useUnlink ? activeActions.unlink : activeActions.delete)"/>
            <t t-if="displayOptionalFields or hasX2ManyAction">
                <t t-if="hasX2ManyAction">
                    <t t-set="hasDeleteButton" t-value="this.displayDeleteIcon(record)"/>
                    <td class="o_list_record_remove w-print-0 p-print-0 text-center" role="gridcell" t-on-keydown="(ev) => this.onCellKeydown(ev, null, record)" t-on-click.stop="hasDeleteButton ? (ev) => this.onRemoveCellClicked(record, ev) : () => {}" tabindex="-1">
                        <button class="fa d-print-none" t-if="hasDeleteButton" t-att-class="{'fa-trash-o': !useUnlink and activeActions.delete, 'fa-times': useUnlink and activeActions.unlink}" name="delete" aria-label="删除行" tabindex="-1"/>
                    </td>
                </t>
                <td t-else="" role="gridcell" tabindex="-1" class="w-print-0 p-print-0"/>
            </t>
        </tr>
    </t>

</templates>
