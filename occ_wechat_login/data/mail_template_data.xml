<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_email_verification" model="mail.template">
            <field name="name">OCC: Email Verification</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="subject">Verify your email address for the Odoo Chinese Community</field>
            <field name="email_from">Odoo Chinese Community &lt;odoocc@126.com&gt;</field>
            <field name="email_to">{{ ctx.get('email_to', '') }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
                <div style="margin: 0; padding: 0; font-size: 14px; color: #212529;">
                    <p>Hello <t t-out="object.name or ''"/>,</p>
                    <p>
                        Please verify this email address to finish joining the Odoo Chinese Community.
                        The verification link is valid for 24 hours and can only be used once.
                    </p>
                    <p style="margin: 24px 0; text-align: center;">
                        <a t-att-href="ctx.get('verification_url')"
                           style="display: inline-block; padding: 10px 20px; color: #ffffff; background-color: #07c160; border-radius: 5px; text-decoration: none;">
                            Verify email address
                        </a>
                    </p>
                    <p>
                        If the button does not work, copy and open this address in your browser:<br/>
                        <a t-att-href="ctx.get('verification_url')" t-out="ctx.get('verification_url')"/>
                    </p>
                    <p>If you did not request this message, you can safely ignore it.</p>
                </div>
            </field>
        </record>

        <record id="mail_template_initial_credentials" model="mail.template">
            <field name="name">OCC: Initial Login Credentials</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="subject">Your Odoo Chinese Community account is ready</field>
            <field name="email_from">Odoo Chinese Community &lt;odoocc@126.com&gt;</field>
            <field name="email_to">{{ ctx.get('initial_login', object.email or '') }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
                <div style="margin: 0; padding: 0; font-size: 14px; color: #212529;">
                    <p>Hello <t t-out="ctx.get('community_username') or object.name or ''"/>,</p>
                    <p>
                        Your Odoo Chinese Community account has been activated. You can now sign in
                        either by scanning the WeChat QR code or with the email and initial password below.
                    </p>
                    <table style="margin: 20px 0; border-collapse: collapse;">
                        <tr>
                            <td style="padding: 6px 12px 6px 0;"><strong>Login email</strong></td>
                            <td style="padding: 6px 0;"><code t-out="ctx.get('initial_login')"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 6px 12px 6px 0;"><strong>Community username</strong></td>
                            <td style="padding: 6px 0;"><code t-out="ctx.get('community_username')"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 6px 12px 6px 0;"><strong>Initial password</strong></td>
                            <td style="padding: 6px 0;"><code t-out="ctx.get('initial_password')"/></td>
                        </tr>
                    </table>
                    <p>Please sign in and change this initial password as soon as possible.</p>
                    <p>For your security, do not forward or share this email.</p>
                </div>
            </field>
        </record>
    </data>
</odoo>
