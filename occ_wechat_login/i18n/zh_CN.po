#. module: occ_wechat_login
#: model:mail.template,body_html:occ_wechat_login.mail_template_initial_credentials
msgid ""
"<div style=\"margin: 0; padding: 0; font-size: 14px; color: #212529;\">\n"
"                    <p>Hello <t t-out=\"ctx.get('community_username') or object.name or ''\"/>,</p>\n"
"                    <p>\n"
"                        Your Odoo Chinese Community account has been activated. You can now sign in\n"
"                        either by scanning the WeChat QR code or with the email and initial password below.\n"
"                    </p>\n"
"                    <table style=\"margin: 20px 0; border-collapse: collapse;\">\n"
"                        <tr>\n"
"                            <td style=\"padding: 6px 12px 6px 0;\"><strong>Login email</strong></td>\n"
"                            <td style=\"padding: 6px 0;\"><code t-out=\"ctx.get('initial_login')\"/></td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"padding: 6px 12px 6px 0;\"><strong>Community username</strong></td>\n"
"                            <td style=\"padding: 6px 0;\"><code t-out=\"ctx.get('community_username')\"/></td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"padding: 6px 12px 6px 0;\"><strong>Initial password</strong></td>\n"
"                            <td style=\"padding: 6px 0;\"><code t-out=\"ctx.get('initial_password')\"/></td>\n"
"                        </tr>\n"
"                    </table>\n"
"                    <p>Please sign in and change this initial password as soon as possible.</p>\n"
"                    <p>For your security, do not forward or share this email.</p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0; padding: 0; font-size: 14px; color: #212529;\">\n"
"                    <p>您好 <t t-out=\"ctx.get('community_username') or object.name or ''\"/>：</p>\n"
"                    <p>\n"
"                        您的 Odoo 中文社区账号已激活。现在可以使用微信扫码登录，\n"
"                        也可以使用下方邮箱和初始密码登录。\n"
"                    </p>\n"
"                    <table style=\"margin: 20px 0; border-collapse: collapse;\">\n"
"                        <tr>\n"
"                            <td style=\"padding: 6px 12px 6px 0;\"><strong>登录邮箱</strong></td>\n"
"                            <td style=\"padding: 6px 0;\"><code t-out=\"ctx.get('initial_login')\"/></td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"padding: 6px 12px 6px 0;\"><strong>社区用户名</strong></td>\n"
"                            <td style=\"padding: 6px 0;\"><code t-out=\"ctx.get('community_username')\"/></td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"padding: 6px 12px 6px 0;\"><strong>初始密码</strong></td>\n"
"                            <td style=\"padding: 6px 0;\"><code t-out=\"ctx.get('initial_password')\"/></td>\n"
"                        </tr>\n"
"                    </table>\n"
"                    <p>请尽快登录并修改初始密码。</p>\n"
"                    <p>为保障账号安全，请勿转发或分享本邮件。</p>\n"
"                </div>\n"
"            "

#. module: occ_wechat_login
#: model:mail.template,body_html:occ_wechat_login.mail_template_email_verification
msgid ""
"<div style=\"margin: 0; padding: 0; font-size: 14px; color: #212529;\">\n"
"                    <p>Hello <t t-out=\"object.name or ''\"/>,</p>\n"
"                    <p>\n"
"                        Please verify this email address to finish joining the Odoo Chinese Community.\n"
"                        The verification link is valid for 24 hours and can only be used once.\n"
"                    </p>\n"
"                    <p style=\"margin: 24px 0; text-align: center;\">\n"
"                        <a t-att-href=\"ctx.get('verification_url')\" style=\"display: inline-block; padding: 10px 20px; color: #ffffff; background-color: #07c160; border-radius: 5px; text-decoration: none;\">\n"
"                            Verify email address\n"
"                        </a>\n"
"                    </p>\n"
"                    <p>\n"
"                        If the button does not work, copy and open this address in your browser:<br/>\n"
"                        <a t-att-href=\"ctx.get('verification_url')\" t-out=\"ctx.get('verification_url')\"/>\n"
"                    </p>\n"
"                    <p>If you did not request this message, you can safely ignore it.</p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0; padding: 0; font-size: 14px; color: #212529;\">\n"
"                    <p>您好 <t t-out=\"object.name or ''\"/>：</p>\n"
"                    <p>\n"
"                        请验证此邮箱地址，以完成加入 Odoo 中文社区的流程。\n"
"                        验证链接有效期为 24 小时，并且只能使用一次。\n"
"                    </p>\n"
"                    <p style=\"margin: 24px 0; text-align: center;\">\n"
"                        <a t-att-href=\"ctx.get('verification_url')\" style=\"display: inline-block; padding: 10px 20px; color: #ffffff; background-color: #07c160; border-radius: 5px; text-decoration: none;\">\n"
"                            验证邮箱地址\n"
"                        </a>\n"
"                    </p>\n"
"                    <p>\n"
"                        如果按钮无法使用，请复制以下地址并在浏览器中打开：<br/>\n"
"                        <a t-att-href=\"ctx.get('verification_url')\" t-out=\"ctx.get('verification_url')\"/>\n"
"                    </p>\n"
"                    <p>如果您未申请此操作，可以安全地忽略本邮件。</p>\n"
"                </div>\n"
"            "

